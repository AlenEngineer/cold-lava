          }
        },
        {
          "shape": {
            "id": "now",
            "use": "tick",
            "from": [
              0.82,
              0.2
            ],
            "to": [
              0.92,
              0.8
            ]
          }
        },
        {
          "text": {
            "value": "1800",
            "at": "past.mark.bottom"
          }
        },
        {
          "text": {
            "value": "1900",
            "at": "then.mark.bottom"
          }
        },
        {
          "text": {
            "value": ":eruption: now",
