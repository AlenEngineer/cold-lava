{
  "shapes": [
    {
      "id": "text",
      "origin": {
        "kind": "built-in"
      },
      "title": "Text",
      "inputs": [
        "text"
      ],
      "aspect": 3.0,
      "parts": [
        {
          "text": {
            "id": "body",
            "value": "${text}",
            "from": [
              0.0,
              0.0
            ],
            "to": [
              1.0,
              1.0
            ]
          }
        }
      ]
    },
    {
