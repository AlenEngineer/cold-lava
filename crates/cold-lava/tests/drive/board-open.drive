# A drawing opened from a backlink selects the card that links, and Back and Forward return to
# it with that card selected (docs/extensions.md, "The canvas owner, as built").
size 140x30
env COLD_LAVA_EDITOR=none
wait-for example-workspace
keys /
type krakatoa
wait-for Krakatoa
keys enter
wait-for ← Volcano Venn.canvas  Volcanoes/Krakatoa.md
expect-in 26 64 26 120 ← Volcano Venn.canvas  Volcanoes/Krakatoa.md
click 26 80
wait-for backlinks · ↑↓ choose
click 26 80
wait-for whiteboard Volcano Venn
wait-for shape card · Card (a note)
expect Ctrl-o ⟵ Krakatoa
keys ctrl+o
wait-for Volcanoes/Krakatoa  reader
wait-for Alt-→ ⟶ Volcano Venn
keys alt+right
wait-for whiteboard Volcano Venn
wait-for shape card · Card (a note)
keys q
wait-for cold-lava workspaces
keys q
exits 0
