# A type an owner ships (docs/extensions.md, "Owners and types, as built"). csv-table, installed
# in the empty home by tests/drive.rs, ships csv-table.row in its manifest for the CSV rows none
# of the workspace's types matches: Volcanoes/Observatories.csv's rows are csv-table.row, while
# Eruptions.csv's stay eruptions, which the workspace's own type matches by their columns.
size 140x30
env COLD_LAVA_EDITOR=none
wait-for example-workspace
keys /
type vesuvius
wait-for Vesuvius
keys enter
# csv-table has read the CSV: its row links to Vesuvius.
wait-for ← Observatories.csv
keys esc esc
wait-for cold-lava workspaces
keys i
wait-for csv-table.row        3
expect eruption             8
type csv-table
wait-for rows · /csv-table
keys enter
wait-for 3 rows
expect Hawaiian Volcano Observatory  Kīlauea
expect-not Krakatoa
screen
# Its fields are written back like any type's: through csv-table, read back before it is saved.
keys e
wait-for name: Vesuvius Observatory▏
keys ctrl+u
type Osservatorio Vesuviano
keys enter
wait-for 12s Volcanoes/Observatories.csv: name set to Osservatorio Vesuviano
keys esc
wait-for cold-lava workspaces
keys q
exits 0
